                    },
                    "currency_id": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "ID de una moneda existente.",
                        "example": 1
                    },
                    "tax_cost": {
                        "type": "number",
                        "format": "float",
                        "minimum": 0,
                        "description": "Costo de impuestos. Se acepta un número o una cadena numérica.",
                        "example": 5
                    },
                    "manufacturing_cost": {
                        "type": "number",
