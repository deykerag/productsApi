                        "minimum": 0,
                        "description": "Costo de fabricación. Se acepta un número o una cadena numérica.",
                        "example": 10
                    }
                }
            },
            "UpdateProductRequest": {
                "type": "object",
                "required": [
                    "name",
                    "description",
                    "price",
                    "currency_id",
                    "tax_cost",
                    "manufacturing_cost"
                ],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 255,
