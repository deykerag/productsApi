            "CreateCurrencyRequest": {
                "type": "object",
                "required": ["name", "code", "symbol", "exchange_rate"],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 255,
                        "example": "Peso colombiano"
